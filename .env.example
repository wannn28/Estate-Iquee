# Copy to .env (chmod 600) and replace every "change-me" value. Never commit .env.
# Generate secrets with:  openssl rand -hex 24   /   openssl rand -hex 32
MYSQL_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-me
JWT_SECRET=change-me-to-at-least-32-random-characters
API_PORT=3006
API_VERSION=1.0.0
CORS_ORIGINS=https://estate.iquee.tech
# Public demo admin login for /admin (prefilled on the page, not a secret)
DEMO_ADMIN_EMAIL=admin@hollisrow.example
DEMO_ADMIN_PASSWORD=hollis-demo
# Mask visitor names/emails in the admin views; purge submissions after this long
ADMIN_MASK_PII=true
RETENTION=336h
LOG_LEVEL=info
